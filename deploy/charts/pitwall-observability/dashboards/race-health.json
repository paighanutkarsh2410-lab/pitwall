        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pitwall:slo_error_ratio:rate1h{slo=\"telemetry-freshness\"} / on(slo) (1 - pitwall:slo_objective{slo=\"telemetry-freshness\"})",
          "legendFormat": "telemetry-freshness",
