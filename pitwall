#!/usr/bin/env bash
# One command to run Pitwall on this machine.
#
#   ./pitwall up        a kind cluster with everything on it, a race to replay; waits until the
#                       race is live on the pit wall (about 15 minutes the first time)
#   ./pitwall status    what's running, and where to look
#   ./pitwall down      delete the cluster (downloaded races in ~/.pitwall are kept)
#
# Needs Docker (give it 10 GB of memory), kind, kubectl and Helm. No Python: the race is
# downloaded with Pitwall's own image. Runs in Git Bash on Windows, and on macOS or Linux.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
CLUSTER=pitwall
PORT="${PITWALL_HTTP_PORT:-8080}"
URL="http://localhost:$PORT"
RACE="${PITWALL_RACE:-2024-sao-paulo}"
HOME_DIR="${PITWALL_HOME:-$HOME/.pitwall}"

say() { printf '\033[1;33m▸ %s\033[0m\n' "$*"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
host_path() { if command -v cygpath >/dev/null; then cygpath -m "$1"; else printf '%s' "$1"; fi; }
image() { echo "ghcr.io/paighanutkarsh2410-lab/pitwall:$(awk '$1 == "tag:" { print $2; exit }' "$ROOT/deploy/env/local/pitwall.yaml")"; }
cluster_exists() { kind get clusters 2>/dev/null | grep -qx "$CLUSTER"; }

preflight() {
  for tool in docker kind kubectl helm curl openssl; do
    command -v "$tool" >/dev/null || fail "Missing $tool. Install it and re-run."
  done
  docker info >/dev/null 2>&1 || fail "Docker is not running. Start it and re-run."
  local memory
  memory="$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)"
  if [ "$memory" -lt $((9 * 1024 * 1024 * 1024)) ]; then
    printf 'Docker has %s GB of memory; Pitwall wants about 10. ' "$((memory / 1024 / 1024 / 1024))"
    echo "It may run out (Docker Desktop: Settings > Resources, or WSL's .wslconfig)."
  fi
}

fetch_race() {
  if [ -d "$HOME_DIR/races/$RACE" ]; then
    echo "Race $RACE: already downloaded"
    return
  fi
  say "Downloading $RACE from OpenF1 (once; about 6 minutes)"
  mkdir -p "$HOME_DIR"
  local user=()
  # On Linux the container must write as you; Docker Desktop's file sharing doesn't care.
  [ "$(uname -s)" = Linux ] && user=(--user "$(id -u):$(id -g)")
  MSYS_NO_PATHCONV=1 docker run --rm "${user[@]}" -v "$(host_path "$HOME_DIR"):/data" \
    "$(image)" fetch "$RACE"
}

# Waits until a check passes, printing what it's waiting for every 30 s.
wait_for() {
  local what="$1" limit="$2"; shift 2
  local start=$SECONDS last=-30
  until "$@" >/dev/null 2>&1; do
    [ $((SECONDS - start)) -gt "$limit" ] && fail "$what: still not ready after $((limit / 60)) minutes (./pitwall status)"
    if [ $((SECONDS - last)) -ge 30 ]; then
      echo "  waiting for $what ($((SECONDS - start)) s)"
      last=$SECONDS
    fi
    sleep 5
  done
  echo "  $what: ready"
}

apps_healthy() {
  local apps
  apps="$(kubectl -n argocd get applications -o jsonpath='{range .items[*]}{.status.health.status}{"\n"}{end}')"
  [ -n "$apps" ] && ! grep -qv Healthy <<<"$apps"
}

rollouts_healthy() {
  local phases
  phases="$(kubectl -n pitwall get rollouts -o jsonpath='{range .items[*]}{.status.phase}{"\n"}{end}')"
  [ -n "$phases" ] && ! grep -qv Healthy <<<"$phases"
}

race_live() {
  curl -fs "$URL/api/state" | grep -q '"lap":'
}

up() {
  preflight
  fetch_race
  PITWALL_HOME="$HOME_DIR" "$ROOT/scripts/cluster-up.sh"
  say "Waiting for the race to go live"
  wait_for "Argo CD applications" 1200 apps_healthy
  wait_for "the services" 600 rollouts_healthy
  wait_for "a race on the pit wall" 300 race_live
  echo
  say "Pitwall is live: $URL"
}

status() {
  cluster_exists || { echo "No Pitwall cluster. Start one with: ./pitwall up"; return; }
  kubectl config use-context "kind-$CLUSTER" >/dev/null
  say "Argo CD applications"
  kubectl -n argocd get applications \
    -o custom-columns='APP:.metadata.name,SYNC:.status.sync.status,HEALTH:.status.health.status'
  say "Services"
  kubectl -n pitwall get rollouts \
    -o custom-columns='SERVICE:.metadata.name,PHASE:.status.phase,PODS:.status.readyReplicas'
  say "The race"
  curl -fs "$URL/api/replay" || echo "The pit wall isn't answering at $URL"
  echo
  cat <<LINKS
Pit wall:    $URL
Grafana:     http://grafana.pitwall.localtest.me:$PORT
Prometheus:  http://prometheus.pitwall.localtest.me:$PORT
Argo CD:     http://argocd.pitwall.localtest.me:$PORT
LINKS
}

down() {
  cluster_exists || { echo "No Pitwall cluster."; return; }
  if [ -t 0 ] && [ "${1:-}" != "-y" ]; then
    read -r -p "Delete the '$CLUSTER' cluster and everything on it (races in $HOME_DIR are kept)? [y/N] " answer
    [ "$answer" = y ] || [ "$answer" = Y ] || { echo "Kept."; return; }
  fi
  kind delete cluster --name "$CLUSTER"
}

case "${1:-}" in
  up) up ;;
  status) status ;;
  down) shift; down "$@" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
